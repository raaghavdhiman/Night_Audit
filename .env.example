# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-nebius-token-factory-key
TAVILY_API_KEY=your-tavily-key

# Optional live-mode limits (defaults shown)
SPEND_CAP_USD=5.0
PER_IP_DAILY_RUNS=3
GLOBAL_DAILY_RUNS=30
MAX_REVIEWS_PER_UPLOAD=150
MAX_UPLOAD_BYTES=1000000
# Set to 0 to force demo-only mode (no model calls ever)
LIVE_MODE_ENABLED=1
